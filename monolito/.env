# Variables de entorno para Docker Compose - Monolito

# IP del host (cambiar según tu máquina)
HOST_IP=192.168.1.100

# PostgreSQL (debe estar corriendo externamente)
DB_HOST=${HOST_IP}
DB_PORT=5432
DB_NAME=toolrent_db
DB_USERNAME=postgres
DB_PASSWORD=1234

# Keycloak (debe estar corriendo externamente)
KEYCLOAK_SERVER_URL=http://${HOST_IP}:8080
KEYCLOAK_REALM=toolrent-realm
KEYCLOAK_CLIENT_ID=toolrent-frontend

# Puertos expuestos
NGINX_FRONTEND_PORT=8070
NGINX_BACKEND_PORT=8081

