# Variables de entorno para el frontend de ToolRent en PRODUCCIÓN

# Keycloak Configuration (Puerto 8090 - no interferir con otros microservicios en 8080)
VITE_KEYCLOAK_CLIENT_ID=toolrent-frontend
VITE_KEYCLOAK_REALM=toolrent-realm
VITE_KEYCLOAK_URL=http://keycloak:8090

# API Gateway Configuration
VITE_API_GATEWAY_PORT=30080

# Minikube IP (IMPORTANTE: Cambiar por la IP real de tu minikube)
# Ejecutar: minikube ip
VITE_MINIKUBE_IP=192.168.59.100

# Modo de aplicación
VITE_APP_MODE=production


